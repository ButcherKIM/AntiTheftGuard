<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0F172A">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/ic_menu_camera"
        android:tint="#EF4444"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStreamTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 원격 보안 스트리밍 중"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvStreamDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="호스트 웹으로 카메라 영상과 오디오를 실시간 전송 중입니다."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvCameraType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📷 후면 카메라 전송 중"
        android:textColor="#60A5FA"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#1E293B"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="03:00"
        android:textColor="#EF4444"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStopStream"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="스트리밍 중지 및 화면 닫기"
        android:textColor="#FFFFFF"
        android:backgroundTint="#EF4444"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
