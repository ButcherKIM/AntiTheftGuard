<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Center Status Circle: Green (Active) or Red (Stopped) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleService"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="42dp"
        app:elevation="0dp"
        android:backgroundTint="#10B981"
        app:rippleColor="#FFFFFF"
        android:text=""
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom: Recent GPS Transmission Time (Only timestamp numbers in clean black text) -->
    <TextView
        android:id="@+id/tvLastGpsSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
